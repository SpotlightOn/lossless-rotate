{
  "name": "@chimok/lossless-rotate",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpotlightOn/lossless-rotate.git"
  },
  "homepage": "https://github.com/SpotlightOn/lossless-rotate#readme",
  "bugs": {
    "url": "https://github.com/SpotlightOn/lossless-rotate/issues"
  },
  "description": "Make JPEGs upright or crop them: read and write the EXIF orientation tag, rotate and crop JPEGs losslessly in the DCT domain, and handle the orientation of AVIF.",
  "author": {
    "name": "SpotlightOn",
    "url": "https://github.com/SpotlightOn"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">= 24.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "sideEffects": false,
  "keywords": [
    "jpeg",
    "jpg",
    "avif",
    "exif",
    "orientation",
    "autorotate",
    "auto-rotate",
    "rotate",
    "crop",
    "lossless",
    "jpegtran",
    "dct",
    "isobmff",
    "irot",
    "imir"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./exif": {
      "types": "./dist/src/exif.d.ts",
      "default": "./dist/src/exif.js"
    },
    "./orientation": {
      "types": "./dist/src/orientation.d.ts",
      "default": "./dist/src/orientation.js"
    },
    "./avif": {
      "types": "./dist/src/avif/orientation.d.ts",
      "default": "./dist/src/avif/orientation.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lossless-rotate": "./dist/bin/lossless-rotate.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "fixtures": "node scripts/make-fixtures.mjs",
    "build": "tsc -p tsconfig.build.json",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run verify:package"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
